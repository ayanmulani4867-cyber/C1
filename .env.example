# =========================================================================
# Campus Connect College ERP - Production Environment Variables
# Copy this file to .env for local deployment.
# Set these variables in Vercel Project Settings for production deployment.
# NEVER commit real credentials or private keys to source control.
# =========================================================================

# Flask Application Mode ('production' on Vercel, 'development' for local)
FLASK_ENV=production

# Application Security Keys (Cryptographic signing for sessions and JWT)
SECRET_KEY=
JWT_SECRET_KEY=

# Firebase Realtime Database Production Endpoint URL (Required)
FIREBASE_DATABASE_URL=https://campus-connect-4e66c-default-rtdb.firebaseio.com/

# --- Firebase Production Authentication (Provide Option C OR Option A OR Option B) ---
# Option C (Recommended if GCP blocks service account key creation):
# Firebase Console > Project Settings > Service Accounts > Database Secrets
FIREBASE_DATABASE_SECRET=

# Option A (Firebase Admin SDK Service Account):
# Option A1: Complete service account JSON (raw single-line or base64)
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option A2: Discrete fields (alternative to full JSON)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option B (Workload Identity Federation / Google OAuth2 Access Token):
FIREBASE_ACCESS_TOKEN=

# Local Server Port (Optional, default: 5000)
PORT=5000

